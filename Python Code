import pandas as pd

# 1. Load the dataset
# Assuming 'books.csv' has columns: title, author, edition, year, publisher, price
try:
    df = pd.read_csv('books.csv')
    
    # a) Print the complete report in a tabular form
    print("--- Complete Book Report ---")
    print(df.to_string(index=False))
    print("\n")

    # b) Print list of books of a given author
    target_author = input("Enter author name to search: ")
    author_books = df[df['author'].str.contains(target_author, case=False)]
    print(f"Books by {target_author}:")
    print(author_books[['title', 'edition', 'price']])
    print("\n")

    # c) Print list of books of a given publishing house
    target_pub = input("Enter publishing house to search: ")
    pub_books = df[df['publisher'].str.contains(target_pub, case=False)]
    print(f"Books from {target_pub}:")
    print(pub_books[['title', 'author', 'year']])
    print("\n")

    # d) Print titles of cheapest & costliest book
    cheapest = df.loc[df['price'].idxmin(), 'title']
    costliest = df.loc[df['price'].idxmax(), 'title']
    print(f"Cheapest Book: {cheapest}")
    print(f"Costliest Book: {costliest}")
    print("\n")

    # e) Print the list by sorting based on year of publication
    sorted_df = df.sort_values(by='year')
    print("--- Books Sorted by Publication Year ---")
    print(sorted_df[['year', 'title', 'author']])

except FileNotFoundError:
    print("Error: 'books.csv' file not found. Please ensure the file exists.")

