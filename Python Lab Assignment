def copy_without_comments():
    # 1. Ask the user for source and destination file names
    source_file = input("Enter the source Python file name (e.g., source.py): ").strip()
    dest_file = input("Enter the destination file name (e.g., dest.py): ").strip()

    try:
        # 2. Open source for reading and destination for writing
        with open(source_file, 'r') as src, open(dest_file, 'w') as dst:
            for line in src:
                # 3. Strip whitespace and skip lines starting with '#'
                # This excludes full-line comments
                if not line.lstrip().startswith('#'):
                    dst.write(line)
        
        print(f"\nSuccessfully copied {source_file} to {dest_file} (excluding comments).\n")

        # 4. Print contents of both files for verification
        print("--- Content of Source File ---")
        with open(source_file, 'r') as src:
            print(src.read())

        print("\n--- Content of Destination File ---")
        with open(dest_file, 'r') as dst:
            print(dst.read())

    except FileNotFoundError:
        print(f"Error: The file '{source_file}' was not found.")
    except Exception as e:
        print(f"An error occurred: {e}")

if __name__ == "__main__":
    copy_without_comments()
