class Book:
    def __init__(self, book_id, title, author):
        self.book_id = book_id
        self.title = title
        self.author = author
        self.is_lent = False

    def __str__(self):
        status = "Lent" if self.is_lent else "Available"
        return f"ID: {self.book_id} | Title: {self.title:<20} | Author: {self.author:<15} | Status: {status}"

