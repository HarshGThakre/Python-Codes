def convert_to_uppercase(source_file, target_file):
    try:
        # Open source file for reading and target file for writing
        with open(source_file, 'r') as infile, open(target_file, 'w') as outfile:
            # Read the entire content
            content = infile.read()
            # Convert to uppercase and write to the new file
            outfile.write(content.upper())
        
        print(f"Content from '{source_file}' has been successfully copied to '{target_file}' in uppercase.")
    
    except FileNotFoundError:
        print(f"Error: The file '{source_file}' was not found.")
    except Exception as e:
        print(f"An unexpected error occurred: {e}")

# Example usage:
convert_to_uppercase('input.txt', 'output.txt')

