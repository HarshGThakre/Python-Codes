class Library:
    def __init__(self):
        self.books = {}
        self.members = {}

    def add_book(self, book_id, title, author):
        if book_id not in self.books:
            self.books[book_id] = Book(book_id, title, author)
            print(f"Book '{title}' added successfully.")
        else:
            print("Error: Book ID already exists.")

    def lend_book(self, book_id):
        book = self.books.get(book_id)
        if book and not book.is_lent:
            book.is_lent = True
            print(f"Book '{book.title}' has been lent.")
        elif book:
            print("Error: Book is already lent out.")
        else:
            print("Error: Book not found.")

    def return_book(self, book_id):
        book = self.books.get(book_id)
        if book and book.is_lent:
            book.is_lent = False
            print(f"Book '{book.title}' returned successfully.")
        elif book:
            print("Error: Book was not lent.")
        else:
            print("Error: Book not found.")

    def display_books(self):
        if not self.books:
            print("The library is currently empty.")
        else:
            print("\n--- Library Inventory ---")
            for book in self.books.values():
                print(book)

def main():
    lib = Library()
    
    while True:
        print("\n--- Library Management Menu ---")
        print("1. Add Book\n2. Lend Book\n3. Return Book\n4. Display Books\n5. Exit")
        choice = input("Enter your choice (1-5): ")

        if choice == '1':
            bid = input("Enter Book ID: ")
            title = input("Enter Title: ")
            author = input("Enter Author: ")
            lib.add_book(bid, title, author)
        elif choice == '2':
            bid = input("Enter Book ID to lend: ")
            lib.lend_book(bid)
        elif choice == '3':
            bid = input("Enter Book ID to return: ")
            lib.return_book(bid)
        elif choice == '4':
            lib.display_books()
        elif choice == '5':
            print("Exiting System. Goodbye!")
            break
        else:
            print("Invalid choice, please try again.")

if __name__ == "__main__":
    main()
