import numpy as np

# 1. Prompt the user to enter a series of integers, separated by either commas or spaces.
user_input = input("Enter a series of integers, separated by commas or spaces: ")

# 2. Split the user_input string into individual string elements.
# Replace commas with spaces and then split by spaces to handle both separators
string_elements = user_input.replace(',', ' ').split()

# 3. Convert each string element to an integer and store them in a list.
# Use a try-except block to handle potential non-integer inputs gracefully
integers_list = []
for s in string_elements:
    try:
        integers_list.append(int(s))
    except ValueError:
        print(f"Warning: Skipping non-integer input '{s}'")

# 4. Convert the list of integers into a tuple.
result_tuple = tuple(integers_list)

# 5. Print the resulting tuple.
print(f"The created tuple is: {result_tuple}")


